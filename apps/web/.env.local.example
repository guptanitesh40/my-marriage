# Copy to apps/web/.env.local for local development. Never commit real values.
# Nothing here is exposed to the browser (no NEXT_PUBLIC_ variables yet).

# Origin of the NestJS API. Used twice: /api/v1/* is forwarded to it (fixed
# when `next build` runs), and Server Components call it directly (read when
# the server starts). Falls back to http://localhost:4000 locally; a Vercel
# build fails without it, or with a local address.
API_ORIGIN=http://localhost:4000
