# Copy to apps/api/.env for local development. Never commit real values.
# Validated at startup by src/config/env.ts — the process refuses to boot if
# anything required is missing or malformed.

NODE_ENV=development
PORT=4000

# Local services from compose.yaml (`pnpm services:up`). MongoDB there is a
# single-node replica set, which transactions require; directConnection lets
# the driver reach it on whatever host port it is published. In staging and
# production this is the Atlas connection string instead.
MONGODB_URI=mongodb://localhost:27017/my_marriage?directConnection=true
REDIS_URL=redis://localhost:6379

# Reverse proxies in front of the API whose X-Forwarded-For entry is trusted
# for the client address. 0 locally; 1 behind a single load balancer.
TRUST_PROXY_HOPS=0

# Public origin of the web app: links in emails point here, and it is the one
# origin the CSRF check trusts. No trailing slash.
WEB_ORIGIN=http://localhost:3000

# How the worker delivers email. Locally, `file` writes each email (HTML and
# JSON) to MAIL_FILE_DIR so you can open it and click its links; integration
# tests use `memory`; `smtp` sends real email through Gmail. Staging and
# production must use `smtp`.
MAIL_TRANSPORT=file
MAIL_FILE_DIR=.mail

# Only for MAIL_TRANSPORT=smtp. SMTP_USER is the Gmail address that sends;
# SMTP_PASSWORD is a Google App Password for it (Google Account → Security →
# 2-Step Verification → App passwords), never the account's own password.
# Emails come from `My Marriage <SMTP_USER>` unless MAIL_FROM names another
# address added to that Gmail account ("Send mail as"). Gmail allows about
# 500 emails a day. In AWS these come from Secrets Manager, never from a
# committed file.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=My Marriage <you@gmail.com>

# Request tracing: which functions each request went through, with timings,
# arguments, results, database queries and the response. `full` (the default
# in development) logs every request with its values, names and email
# addresses included, so never in production; `errors` (the production
# default) logs only failed requests, without values; `off`.
# LOG_TRACE=full

# Key from which guests' private invitation links are derived; only a hash
# of each link is stored (decision 0015). At least 32 random characters,
# e.g. `openssl rand -base64 48`. Required in production; development and
# tests use a built-in value when it is empty.
GUEST_LINK_SECRET=

# Uploaded files (decision 0018): one S3 bucket, a folder per kind of file
# (`uploads/` for new uploads while they are checked, `weddings/{id}/…` for
# kept files). Credentials come from the standard AWS chain: a profile
# locally, the task role in AWS. Leave empty in development to keep files
# in MEDIA_LOCAL_DIR on this machine instead.
# S3_BUCKET=my-marriage-app
# AWS_REGION=ap-south-1
# MEDIA_LOCAL_DIR=.media
