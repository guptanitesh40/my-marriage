{
  "name": "my-marriage",
  "version": "0.0.0",
  "private": true,
  "description": "Wedding planning and management platform",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @my-marriage/web --filter @my-marriage/api run \"/^dev(:.*)?$/\"",
    "dev:web": "pnpm --filter @my-marriage/web dev",
    "dev:api": "pnpm --filter @my-marriage/api dev",
    "dev:worker": "pnpm --filter @my-marriage/api dev:worker",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:migrate": "pnpm --filter @my-marriage/api db:migrate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @my-marriage/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contracts:generate": "pnpm --filter @my-marriage/api openapi:export && pnpm --filter @my-marriage/contracts generate"
  },
  "devDependencies": {
    "prettier": "catalog:"
  }
}
