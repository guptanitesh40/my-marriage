{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "requestId"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/HealthDto"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Any failed request, in the standard error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "Operations"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "requestId"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/HealthDto"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Any failed request, in the standard error envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Readiness probe for dependency health",
        "tags": [
          "Operations"
        ]
      }
    }
  },
  "info": {
    "title": "My Marriage API",
    "description": "REST API for the My Marriage wedding planning platform.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. VALIDATION_ERROR or OWNER_ACTIVE_LIMIT.",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary. Safe to show; never contains internals.",
            "example": "Request validation failed"
          },
          "details": {
            "description": "Extra context that depends on the code. A VALIDATION_ERROR raised by a request body lists the invalid fields; other codes may send an object.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldErrorDto"
                }
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetailDto"
          },
          "requestId": {
            "type": "string",
            "example": "req_0b1f6c1e-6f0c-4f7e-9a52-0a4d6f1f2b77"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Always \"ok\": a failed check is a 503 in the standard error envelope instead.",
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "checks": {
            "description": "The dependencies that were checked and are reachable. Empty for the liveness probe.",
            "example": [
              "mongodb",
              "redis"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Dotted path of the invalid property, e.g. `venue.name`.",
            "example": "email"
          },
          "messages": {
            "example": [
              "email must be an email"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "messages"
        ]
      }
    }
  }
}
