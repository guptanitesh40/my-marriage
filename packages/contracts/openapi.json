  "info": {
    "title": "My Marriage API",
    "description": "REST API for the My Marriage wedding planning platform.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mm_session"
      }
    },
    "schemas": {
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. VALIDATION_ERROR or OWNER_ACTIVE_LIMIT.",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary. Safe to show; never contains internals.",
            "example": "Request validation failed"
          },
          "details": {
            "description": "Extra context that depends on the code. A VALIDATION_ERROR raised by a request body lists the invalid fields; other codes may send an object.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldErrorDto"
                }
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetailDto"
          },
          "requestId": {
            "type": "string",
            "example": "req_0b1f6c1e-6f0c-4f7e-9a52-0a4d6f1f2b77"
          }
