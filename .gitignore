# dependencies
node_modules/

# build output
dist/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# tests
coverage/
test-results/
playwright-report/
blob-report/

# environment files — only the *.example files are committed
.env
.env.*
!.env.example
!.env.local.example

# logs
*.log
npm-debug.log*
.pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# secrets that must never be committed
*.pem
*.key

# MCP server config holds personal API keys
.mcp.json

# Emails written by the local file mail transport (they contain live links)
.mail/

# Emails written by the API during browser tests
.e2e-mail/
# Uploaded files kept locally when no S3 bucket is set (development, tests).
.media/

# graphify: the graph is shared; its local cache is not.
graphify-out/cache/
graphify-out/.cloud-cta-shown

# Dev server output (`pnpm dev > dev.log`): holds names and email addresses.
dev.log
